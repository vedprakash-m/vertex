# Generic catch-all: any ad-hoc `> file.txt`/`> file.csv` shell-redirect dump
# left in the repo root (real program data should never land here).
/*_output.txt
/*_full.csv
reports/*
!reports/*/
reports/*/*
!reports/schemas/
!reports/schemas/**
!reports/*/backfill.yaml
specs/*
!specs/vertex-prd.md
!specs/vertex-tech-spec.md
!specs/vertex-ux-spec.md
!specs/bklg.md
# specs/bklg.md (BL-K1, resolved 2026-07-22): the tracked, sanitized canonical
# remaining-work backlog. specs/backlog.md (still gitignored below) remains
# the actively-edited working copy with full, unsanitized operational detail
# (e.g. real annotator identities) — see specs/bklg.md's own header for the
# resync convention between the two.
# Canonical specs tracked: PRD, Tech, UX only.
# Other specs, including consolidated.md, are local-only implementation notes.
# The generated CLI reference snapshot lives in tests/contracts/cli_reference_snapshot.md.

# Scratch / temp files accidentally committed
_tmp_check.txt
tests/cassettes/
tests/fixtures/
tests/golden/snapshots/

# Program data — internal/private. Users supply their own program configurations.
# The only tracked exception is sealed example/template config under programs/_templates/.
programs/*
!programs/_templates/
!programs/_templates/**
# Program-level publications workspace (operator data, not committed).
# Explicit scoped entry for PR diff clarity; logically covered by programs/[^_]*/ below.
/programs/*/publications/

# Local Vertex SQLite state databases — contain program-specific runtime data.
vertex-db/
# Runtime RealityStore + Program Fact Store DBs (internal program facts/signals —
# never publish). These materialize under ~/.vertex/<id>/ or a repo-relative
# <program_id>/ dir depending on VERTEX_DB_PATH/db_root; ignore them everywhere.
*.sqlite3
*.sqlite
*.db
vertex.sqlite3
*.sqlite3-wal
*.sqlite3-shm
*.sqlite-wal
*.sqlite-shm
*.db-wal
*.db-shm
*.sqlite-journal
*.sqlite3-journal
*.db-journal
**/.workiq_*.json
# Private program directories (operator-managed, never committed).
# Pattern excludes all programs/<name>/ except the bundled _templates directory.
# This also covers REV inbox dirs: programs/*/rev_inbox/ and programs/*/_rev/
# (raw .eml files; never commit personal email content).
programs/[^_]*/

# Knowledge files — may contain PII or internal team/people data.
# Only *.example.yaml templates are committed.
knowledge/*
!knowledge/*.example.yaml

# Program-operational scripts (contain internal workstream IDs and edition names)
scripts/p0_approve_sections.ps1
scripts/program_*.py
# Exception: generic inventory utility (no program-specific IDs; required by tests)
!scripts/program_inventory.py

# Local one-off enrichment / migration / seeding scripts.
# These contain real stakeholder contacts and internal IDs hard-coded as
# bootstrap data. They are essential for local Vertex operation but must
# remain private. Users supply their own equivalents.
scripts/_enrich_vertex.py
scripts/apply_*.py
scripts/seed_*.py
scripts/bootstrap_*.py
scripts/backfill_*.py
scripts/check_*.py
!scripts/check_backlog_citations.py
!scripts/check_coverage_baseline.py
!scripts/check_spec_drift.py
scripts/create_*.py
scripts/export_*.py
scripts/plan_*.py
scripts/preview_*.py

# Debug / ad-hoc probe scripts — often contain hardcoded work-item IDs,
# internal email addresses, or references to now-archived spec files.
scripts/_*.py
scripts/check3.py
scripts/check_remaining.py
scripts/find_wave_d.py
scripts/close_*.py
scripts/fix_*.py
scripts/validate_*.py
scripts/ddpf_*.py
scripts/xpf_*.py
scripts/nova_*.py
scripts/scrub_*.py
# Armada scheduled-task launcher/registration scripts (Windows Task Scheduler
# wiring, daily gather cadence) -- same program-specific-script rationale as
# the xpf/ddpf/nova entries above.
scripts/*armada*.py
scripts/*armada*.ps1
# Tests that import the hidden operational scripts above (would fail on a fresh clone).
tests/unit/test_validate_*.py
tests/unit/test_check_*.py
!tests/unit/test_check_spec_drift.py
!tests/unit/test_check_backlog_citations.py
tests/unit/test_seed_issue_076_baseline.py
# Program-specific test files that import private scripts (gitignored).
# Any test file whose name contains a specific program name should stay local.
tests/unit/test_*xpf*.py
tests/unit/test_*nova*.py
tests/unit/test_*armada*.py

# Contract tests that depend on local programs/<program-id>/ data (not in the repo).
# These pass only when the operator's local program directory is present.
tests/contracts/test_section_catalog.py
tests/contracts/test_historical_issue_guard.py
tests/contracts/test_workstream_kusto_registry.py

