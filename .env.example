ADO_PAT=
AZURE_OPENAI_ENDPOINT=https://<your-resource-name>.services.ai.azure.com/
AZURE_OPENAI_API_KEY=<your-api-key>
# gpt-5.4-mini requires 2025-01-01-preview or later
AZURE_OPENAI_API_VERSION=2025-01-01-preview
VERTEX_AI_DEPLOYMENT=gpt-5.4-mini
VERTEX_EXEC_DEPLOYMENT=gpt-5.4-mini
# Azure AI Content Safety — Prompt Shields (BL-A1 / AG-3). When both are set,
# `vertex rev run` uses AzurePromptShields (shield_degrade=false on clean EML),
# unblocking the AG-3 clean-cycle authority ladder. Leave unset to fall back to
# local-only shields (visible shield_degrade=true; never counts toward authority).
# Endpoint: your Content Safety resource, e.g. https://<name>.cognitiveservices.azure.com
# Key: the resource's Ocp-Apim-Subscription-Key (Keys and Endpoint blade).
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-content-safety-resource>.cognitiveservices.azure.com
AZURE_CONTENT_SAFETY_KEY=
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
