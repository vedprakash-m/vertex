{# Adapted from Shiproom src/report/templates/report.html.j2 #}
<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light dark">
  <title>{{ title }}</title>
  {% if type_scale_v2 | default(false) %}{% include "partials/typography_v2.j2" %}{% endif %}
</head>
<body style="margin:0; padding:0; background-color:#F9FAFB; font-family:Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif; color:#111827;">
  <div style="display:none; max-height:0; overflow:hidden; opacity:0; mso-hide:all; color:transparent;">
    {{ preheader | default('Newsletter preview') }}
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; background-color:#F9FAFB; margin:0; padding:0;">
    <tr>
      <td align="center" style="padding:24px 12px;">
        <table role="presentation" width="680" cellpadding="0" cellspacing="0" border="0" style="width:680px; max-width:680px; border-collapse:collapse; background-color:#FFFFFF; border:1px solid #E5E7EB;">
          <tr>
            <td align="center" style="padding:0;">
              <table role="presentation" width="640" cellpadding="0" cellspacing="0" border="0" style="width:640px; max-width:640px; border-collapse:collapse;">
                <tr>
                  <td style="padding:24px 0 16px 0; border-bottom:1px solid #E5E7EB;">
                    {% block header %}
                    {% if header_label %}
                    <p style="margin:0 0 8px 0; font-size:12px; line-height:1.4; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#6B7280;">{{ header_label }}</p>
                    {% endif %}
                    <h1 style="margin:0; font-size:20px; line-height:1.3; font-weight:600; color:#111827;">{{ title }}</h1>
                    {% if subtitle %}
                    <p style="margin:8px 0 0 0; font-size:13px; line-height:1.5; color:#6B7280;">{{ subtitle }}</p>
                    {% endif %}
                    {% endblock %}
                  </td>
                </tr>
                <tr>
                  <td style="padding:24px 0; font-size:14px; line-height:1.6; color:#374151;">
                    {% block content %}
                    {{ content_html | default('') | safe }}
                    {% endblock %}
                  </td>
                </tr>
                {% if show_footer %}
                <tr>
                  <td style="padding:16px 0 24px 0; border-top:1px solid #E5E7EB; font-size:11px; line-height:1.4; color:#6B7280; text-align:center;">
                    {% block footer %}
                    {{ footer_text | default('') }}
                    {% endblock %}
                  </td>
                </tr>
                {% endif %}
              </table>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
