{% extends "base.email.j2" %}

{% block header %}
{% if continuity %}
{% include "partials/brand_header.j2" %}
{% endif %}
{% if header_label %}
<p style="margin:0 0 8px 0; font-size:12px; line-height:1.4; font-weight:600; letter-spacing:0.06em; text-transform:uppercase; color:#6B7280;">{{ header_label }}</p>
{% endif %}
<h1 style="margin:0; font-size:20px; line-height:1.3; font-weight:600; color:#111827;">{{ title }}</h1>
{% if subtitle %}
<p style="margin:8px 0 0 0; font-size:13px; line-height:1.5; color:#6B7280;">{{ subtitle }}</p>
{% endif %}
{% endblock %}

{% block content %}
{% if continuity and continuity.edition_intro %}
{% include "partials/edition_intro.j2" %}
{% endif %}
{% if continuity %}
{% if continuity.cadence_note %}
{% include "partials/cadence_note.j2" %}
{% endif %}
{% for band in continuity.scorecard_bands %}
{% include "partials/continuity_scorecard_band.j2" %}
{% endfor %}
{% include "partials/ado_vitality.j2" %}
{% include "partials/continuity_exec_summary.j2" %}
{% include "partials/jump_to_section.j2" %}
{% for chapter in continuity.chapters %}
{% include "partials/continuity_chapter.j2" %}
{% endfor %}
{% include "partials/continuity_provenance_comment.j2" %}
{% endif %}
{% endblock %}

{% block footer %}{% endblock %}