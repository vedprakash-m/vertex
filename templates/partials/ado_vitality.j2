{% if ado_vitality %}
<a id="{{ ado_vitality.section_id }}"></a>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 16px 0; border:1px solid #E5E7EB; background-color:#FFFFFF;">
  <tr>
    <td style="padding:16px 20px; border-bottom:1px solid #E5E7EB; background-color:#F9FAFB;">
      <p style="margin:0; font-size:16px; line-height:1.4; font-weight:700; color:#111827;">{{ ado_vitality.title }}</p>
    </td>
  </tr>
  <tr>
    <td style="padding:16px 20px; font-size:14px; line-height:1.6; color:#374151;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse;">
        <tr>
          <td style="padding:0 0 8px 0; font-weight:600; color:#111827;">Items updated in ADO</td>
          <td style="padding:0 0 8px 0; text-align:right; color:#111827;">{{ ado_vitality.items_updated }} of {{ ado_vitality.items_total }} active ({{ ado_vitality.updated_percentage }}%)</td>
        </tr>
        <tr>
          <td style="padding:0 0 8px 0; font-weight:600; color:#111827;">Avg days since last update</td>
          <td style="padding:0 0 8px 0; text-align:right; color:#111827;">{{ '%.1f'|format(ado_vitality.freshness_average_days) }} days</td>
        </tr>
        <tr>
          <td style="padding:0; font-weight:600; color:#111827;">Items with leakage signals</td>
          <td style="padding:0; text-align:right; color:#111827;">{{ ado_vitality.leakage_events }} {{ ado_vitality.leakage_events | pluralize('item') }} discussed outside ADO without a later ADO update in the same 7-day window</td>
        </tr>
      </table>
      {% if ado_vitality.best_documented_label and ado_vitality.best_documented_detail %}
      <p style="margin:16px 0 0 0; font-size:14px; line-height:1.6; color:#111827;"><strong>Best documented:</strong> {{ ado_vitality.best_documented_label }} — {{ ado_vitality.best_documented_detail }}</p>
      {% endif %}
      <p style="margin:8px 0 0 0; font-size:14px; line-height:1.6; color:#111827;"><strong>Trend:</strong> {{ ado_vitality.trend_summary }}</p>
      {% if ado_vitality.accountability_rows %}
      <p style="margin:16px 0 8px 0; font-size:14px; line-height:1.6; color:#111827;"><strong>Needs ADO update:</strong></p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0; border:1px solid #E5E7EB; table-layout:fixed;">
        <tr style="background-color:#F3F4F6;">
          <td style="padding:8px 10px; border:1px solid #E5E7EB; font-size:12px; line-height:1.4; font-weight:600; color:#111827; width:20%;">Workstream</td>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; font-size:12px; line-height:1.4; font-weight:600; color:#111827; width:28%;">Workstream Owner + ADO Assignee</td>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; font-size:12px; line-height:1.4; font-weight:600; color:#111827; width:26%;">Stale or Missing ADOs</td>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; font-size:12px; line-height:1.4; font-weight:600; color:#111827; width:26%;">What Field Needs Update</td>
        </tr>
        {% for row in ado_vitality.accountability_rows %}
        <tr>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; vertical-align:top; font-size:13px; line-height:1.5; color:#111827;">{{ row.workstream }}</td>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; vertical-align:top; font-size:13px; line-height:1.5; color:#111827;">{{ row.owners_and_assignee }}</td>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; vertical-align:top; font-size:13px; line-height:1.5; color:#111827;"><strong>{{ row.ado_label }}</strong><br/>{{ row.ado_title }}</td>
          <td style="padding:8px 10px; border:1px solid #E5E7EB; vertical-align:top; font-size:13px; line-height:1.5; color:#111827;">{{ row.fields_to_update | join('; ') }}</td>
        </tr>
        {% endfor %}
      </table>
      {% endif %}
    </td>
  </tr>
</table>
{% endif %}