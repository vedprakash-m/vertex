<a id="changes"></a>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 16px 0; border:1px solid #E5E7EB; background-color:#FFFFFF;">
  <tr>
    <td style="padding:14px 16px 8px 16px;">
      <p style="margin:0; font-size:12px; line-height:1.4; font-weight:600; letter-spacing:0.05em; text-transform:uppercase; color:#6B7280;">WHAT CHANGED</p>
    </td>
  </tr>
  <tr>
    <td style="padding:0 16px 16px 16px;">
      {% if visible_delta_rows %}
      {% for row in visible_delta_rows %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #E5E7EB; margin-bottom:6px; border-collapse:collapse;">
        <tr>
          <td style="padding:8px 12px;">
            <p style="margin:0 0 2px 0; font-size:11px; font-weight:600; color:{{ row.kind | delta_fg }}; text-transform:uppercase;">{{ row.label }}</p>
            <p style="margin:0 0 2px 0; font-size:13px; color:#111827;">{{ row.title }}{% if row.work_item_id %} #{{ row.work_item_id }}{% endif %}</p>
            <p style="margin:0; font-size:12px; color:#4B5563;">{{ row.detail }}{% if row.url %} · <a href="{{ row.url }}" style="color:#2563EB; text-decoration:underline;">ADO#{{ row.work_item_id }}</a>{% endif %}</p>
          </td>
        </tr>
      </table>
      {% endfor %}
      {% if delta_rows | length > visible_delta_rows | length %}
      <p style="margin:8px 0 0 0; font-size:13px; line-height:1.5; color:#4B5563;">{{ visible_delta_rows | length }} of {{ delta_rows | length }} changes shown{% if changes_url %} · <a href="{{ changes_url }}" style="color:#2563EB; text-decoration:underline;">View all in ADO →</a>{% endif %}</p>
      {% endif %}
      {% else %}
      <p style="margin:0; font-size:14px; line-height:1.6; color:#4B5563;">No material changes since Issue {{ report.deltas.previous_issue_number or prior_date }}.</p>
      {% endif %}
    </td>
  </tr>
</table>