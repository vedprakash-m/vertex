<a id="health"></a>
{% if health %}
{% if health.high_count == 0 and health.medium_count == 0 and health.total_count > 0 %}
{% set health_state = "HEALTHY" %}
{% set state_bg = "#B4E5A2" %}
{% set state_fg = "#000000" %}
{% elif health.high_count >= 3 %}
{% set health_state = "CRITICAL" %}
{% set state_bg = "#C00000" %}
{% set state_fg = "#FFFFFF" %}
{% elif health.high_count > 0 %}
{% set health_state = "AT RISK" %}
{% set state_bg = "#E97132" %}
{% set state_fg = "#FFFFFF" %}
{% elif health.medium_count > 0 %}
{% set health_state = "ON TRACK" %}
{% set state_bg = "#BF8F00" %}
{% set state_fg = "#FFFFFF" %}
{% else %}
{% set health_state = "NEEDS INPUT" %}
{% set state_bg = "#BFBFBF" %}
{% set state_fg = "#000000" %}
{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 16px 0; border:1px solid #E5E7EB; background-color:#FFFFFF;">
  <tr>
    <td style="padding:16px 20px; background-color:{{ state_bg }}; color:{{ state_fg }}; border-bottom:1px solid #E5E7EB;">
      <p style="margin:0 0 6px 0; font-size:12px; line-height:1.4; font-weight:700; letter-spacing:0.05em; text-transform:uppercase;">Program Health: {{ health_state }}, {{ health.trajectory | upper }}</p>
      {% if health_state == "HEALTHY" %}
      <p style="margin:0 0 6px 0; font-size:14px; line-height:1.5; font-weight:400; color:#111827;">All {{ health.total_count }} dimensions at Low or Done.{% if health.healthy_streak >= 2 %} {{ health.healthy_streak | ordinal }} consecutive healthy week.{% endif %}</p>
      {% elif health.bluf %}<p style="margin:0 0 6px 0; font-size:14px; line-height:1.5; font-weight:400; color:#111827;">{{ health.bluf }}</p>{% endif %}
      {% if health.risk_register_summary %}<p style="margin:0 0 6px 0; font-size:13px; line-height:1.5; color:#111827;">{{ health.risk_register_summary }}</p>{% endif %}
      {% if health.milestone_summary %}<p style="margin:0 0 6px 0; font-size:13px; line-height:1.5; color:#111827;">{{ health.milestone_summary }}</p>{% endif %}
      {% if health.telemetry_summary %}<p style="margin:0 0 6px 0; font-size:13px; line-height:1.5; color:#111827;"><span style="font-weight:600;">Telemetry</span>: {{ health.telemetry_summary }}{% if health.telemetry_confidence %} ({{ health.telemetry_confidence | lower }} confidence){% endif %}</p>{% endif %}
      {% include "partials/milestone_rows.j2" %}
      {% if health.forecast_summary %}<p style="margin:0 0 6px 0; font-size:13px; line-height:1.5; color:#111827;">{{ health.forecast_summary }}{% if health.forecast_confidence %} ({{ health.forecast_confidence | lower }} confidence){% endif %}</p>{% endif %}
      <p style="margin:0 0 6px 0; font-size:14px; line-height:1.5; font-weight:700; color:#374151;">{{ health.leadership_ask }}</p>
      <p style="margin:0; font-size:12px; line-height:1.5; color:#4B5563;">~{{ health.read_time_minutes }} min read · {{ health.edition_label }}</p>
    </td>
  </tr>
  <tr>
    <td style="padding:14px 20px; background-color:#FFFFFF; color:#6B7280; font-size:12px; line-height:1.5;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:separate; border-spacing:8px 0;">
        <tr>
          {% set high_delta = health.high_count - (health.prior_counts.high if health.prior_counts else health.high_count) %}
          {% set medium_delta = health.medium_count - (health.prior_counts.medium if health.prior_counts else health.medium_count) %}
          {% set low_delta = health.low_count - (health.prior_counts.low if health.prior_counts else health.low_count) %}
          <td style="width:72px; background-color:#C00000; border:1px solid #E5E7EB; padding:8px; text-align:center;">
            <p style="margin:0 0 4px 0; font-size:11px; font-weight:700; color:#FFFFFF;">High</p>
            <p style="margin:0; font-size:18px; font-weight:700; color:#FFFFFF;">{{ health.high_count }}{% if health.prior_counts %}({% if high_delta >= 0 %}+{% endif %}{{ high_delta }}){% endif %}</p>
          </td>
          <td style="width:72px; background-color:#BF8F00; border:1px solid #E5E7EB; padding:8px; text-align:center;">
            <p style="margin:0 0 4px 0; font-size:11px; font-weight:700; color:#FFFFFF;">Med</p>
            <p style="margin:0; font-size:18px; font-weight:700; color:#FFFFFF;">{{ health.medium_count }}{% if health.prior_counts %}({% if medium_delta >= 0 %}+{% endif %}{{ medium_delta }}){% endif %}</p>
          </td>
          <td style="width:72px; background-color:#B4E5A2; border:1px solid #E5E7EB; padding:8px; text-align:center;">
            <p style="margin:0 0 4px 0; font-size:11px; font-weight:700; color:#000000;">Low</p>
            <p style="margin:0; font-size:18px; font-weight:700; color:#000000;">{{ health.low_count }}{% if health.prior_counts %}({% if low_delta >= 0 %}+{% endif %}{{ low_delta }}){% endif %}</p>
          </td>
          <td style="width:72px; background-color:#4EA72E; border:1px solid #E5E7EB; padding:8px; text-align:center;">
            <p style="margin:0 0 4px 0; font-size:11px; font-weight:700; color:#FFFFFF;">Done</p>
            <p style="margin:0; font-size:18px; font-weight:700; color:#FFFFFF;">{{ health.done_count }}</p>
          </td>
          <td style="padding:4px 0 4px 8px; vertical-align:middle;">
            <p style="margin:0 0 6px 0; font-size:12px; line-height:1.4; color:#6B7280;">Risk Load: {{ '%.1f'|format(health.risk_load) }}{% if health.prior_risk_load is not none %} (was {{ '%.1f'|format(health.prior_risk_load) }}){% endif %}</p>
            <table width="80" cellpadding="0" cellspacing="0" border="0" role="presentation" style="border:1px solid #D1D5DB; height:6px; margin:0 0 6px 0;">
              <tr>
                <td width="{{ health.risk_load_bar_width }}" style="background:{% if health.high_count >= 3 %}#991B1B{% elif health.high_count > 0 or health.medium_count > 0 %}#F59E0B{% else %}#047857{% endif %}; font-size:0; line-height:0;">&nbsp;</td>
                <td width="{{ 80 - health.risk_load_bar_width }}" style="background:#F3F4F6; font-size:0; line-height:0;">&nbsp;</td>
              </tr>
            </table>
            <p style="margin:0; font-size:12px; line-height:1.4; color:#6B7280;">{{ health.trajectory | capitalize }}</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
{% endif %}