{% set first = kusto_group[0] %}
<a id="{{ section.anchor_id }}"></a>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 16px 0; border:1px solid #E5E7EB; background-color:#FFFFFF;">
  <tr>
    <td style="padding:14px 16px 8px 16px; font-size:16px; line-height:1.4; font-weight:600; color:#111827;">{{ first.title }}</td>
  </tr>
  <tr>
    <td style="padding:0 16px 12px 16px; font-size:13px; line-height:1.5; color:#6B7280;">
      Queries {{ kusto_group | map(attribute='query_id') | join(', ') }}
    </td>
  </tr>
  <tr>
    <td style="padding:0 16px 16px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 12px 0;">
        <tr>
          {% for subgroup in kusto_group %}
          {% for metric in subgroup.metrics %}
          <td style="padding:10px 12px; border:1px solid #E5E7EB; background-color:#F9FAFB; vertical-align:top; width:33%;">
            <p style="margin:0; font-size:11px; line-height:1.4; text-transform:uppercase; color:#6B7280;">{{ metric.label }}</p>
            <p style="margin:6px 0 0 0; font-size:18px; line-height:1.3; font-weight:600; color:#111827;">{{ metric.value }}</p>
          </td>
          {% if loop.index is divisibleby 3 and not (loop.last and loop.parent.last) %}</tr><tr>{% endif %}
          {% endfor %}
          {% endfor %}
        </tr>
      </table>
      {% for subgroup in kusto_group %}
      <p style="margin:0 0 6px 0; font-size:12px; line-height:1.5; color:#6B7280; font-weight:600;">Query {{ subgroup.query_id }} · {{ subgroup.source_label }} · Confidence {{ subgroup.confidence | upper }}</p>
      {% if subgroup.message %}
      <p style="margin:0 0 12px 0; font-size:14px; line-height:1.6; color:{% if subgroup.is_degraded %}#9A3412{% else %}#374151{% endif %};">{{ subgroup.message }}</p>
      {% endif %}
      {% if subgroup.rows %}
      <p style="margin:0 0 6px 0; font-size:12px; line-height:1.5; color:#6B7280; font-weight:600;">{{ subgroup.query_id }}</p>
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 12px 0;">
        <tr>
          {% for column in subgroup.columns %}
          <td style="padding:8px 10px; background-color:#F9FAFB; border-bottom:1px solid #E5E7EB; font-size:11px; line-height:1.4; font-weight:600; text-transform:uppercase; color:#6B7280;">{{ column }}</td>
          {% endfor %}
        </tr>
        {% for row in subgroup.rows %}
        <tr>
          {% for cell in row %}
          <td style="padding:8px 10px; border-bottom:1px solid #E5E7EB; font-size:13px; line-height:1.5; color:#374151;">{% if cell.href %}<a href="{{ cell.href }}" style="color:#2563EB; text-decoration:underline;">{{ cell.text }}</a>{% else %}{{ cell.text }}{% endif %}</td>
          {% endfor %}
        </tr>
        {% endfor %}
      </table>
      {% endif %}
      {% if subgroup.reference_url %}
      <p style="margin:0 0 8px 0; font-size:13px; line-height:1.5;"><a href="{{ subgroup.reference_url }}" style="color:#2563EB; text-decoration:underline;">{{ subgroup.query_id }} dashboard →</a></p>
      {% endif %}
      {% if subgroup.caveats %}
      <p style="margin:0 0 8px 0; font-size:12px; line-height:1.5; color:#6B7280;">{{ subgroup.query_id }} caveats: {{ subgroup.caveats | join('; ') }}</p>
      {% endif %}
      {% endfor %}
    </td>
  </tr>
</table>