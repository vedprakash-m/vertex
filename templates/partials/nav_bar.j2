{% if report.edition.value in ["detailed", "focused", "lookback"] %}
{% from "partials/workstream_anchor.j2" import workstream_anchor %}
{% set health_section = ordered_sections | selectattr("kind", "equalto", "health") | first | default(none) %}
{% set decisions_section = ordered_sections | selectattr("kind", "equalto", "top_3") | first | default(none) %}
{% set scorecard_section = ordered_sections | selectattr("kind", "equalto", "scorecard") | first | default(none) %}
{% set changes_section = ordered_sections | selectattr("kind", "equalto", "selected_changes") | first | default(none) %}
{% set detail_section = ordered_sections | selectattr("kind", "equalto", "workstream") | first | default(none) %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" data-vertex-block="jump-to-section" style="width:100%; border-collapse:collapse; margin:0 0 16px 0; background-color:#F9FAFB; border:1px solid #E5E7EB;">
  <tr>
    <td style="padding:8px 10px; font-size:12px; line-height:1.4; font-weight:600; color:#4B5563; text-align:center; white-space:nowrap;">Jump to section</td>
    <td style="padding:8px 0; font-size:12px; line-height:1.4; color:#D1D5DB; text-align:center;">|</td>
    <td style="padding:8px 10px; font-size:12px; line-height:1.4; color:#2563EB; text-align:center;">{% if health_section %}<a href="#{{ health_section.anchor_id }}" aria-label="Jump to Health section" style="color:#2563EB; text-decoration:none;">Health</a>{% else %}Health{% endif %}</td>
    <td style="padding:8px 0; font-size:12px; line-height:1.4; color:#D1D5DB; text-align:center;">|</td>
    <td style="padding:8px 10px; font-size:12px; line-height:1.4; color:#2563EB; text-align:center;">{% if decisions_section %}<a href="#{{ decisions_section.anchor_id }}" aria-label="Jump to Decisions section" style="color:#2563EB; text-decoration:none;">Decisions</a>{% else %}Decisions{% endif %}</td>
    <td style="padding:8px 0; font-size:12px; line-height:1.4; color:#D1D5DB; text-align:center;">|</td>
    <td style="padding:8px 10px; font-size:12px; line-height:1.4; color:#2563EB; text-align:center;">{% if scorecard_section %}<a href="#{{ scorecard_section.anchor_id }}" aria-label="Jump to Scorecards section" style="color:#2563EB; text-decoration:none;">Scorecards</a>{% else %}Scorecards{% endif %}</td>
    <td style="padding:8px 0; font-size:12px; line-height:1.4; color:#D1D5DB; text-align:center;">|</td>
    <td style="padding:8px 10px; font-size:12px; line-height:1.4; color:#2563EB; text-align:center;">{% if changes_section %}<a href="#{{ changes_section.anchor_id }}" aria-label="Jump to Changes section" style="color:#2563EB; text-decoration:none;">Changes</a>{% else %}Changes{% endif %}</td>
    <td style="padding:8px 0; font-size:12px; line-height:1.4; color:#D1D5DB; text-align:center;">|</td>
    <td style="padding:8px 10px; font-size:12px; line-height:1.4; color:#2563EB; text-align:center;">{% if detail_section %}<a href="#{{ workstream_anchor(detail_section.workstream) }}" aria-label="Jump to Details section" style="color:#2563EB; text-decoration:none;">Details</a>{% else %}Details{% endif %}</td>
  </tr>
</table>
{% endif %}
