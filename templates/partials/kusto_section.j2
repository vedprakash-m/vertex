<a id="{{ ks.section_id }}"></a>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 16px 0; border:1px solid #E5E7EB; background-color:#FFFFFF;">
  <tr>
    <td style="padding:14px 16px 8px 16px; font-size:16px; line-height:1.4; font-weight:600; color:#111827;">{{ ks.title }}</td>
  </tr>
  <tr>
    <td style="padding:0 16px 12px 16px; font-size:13px; line-height:1.5; color:#6B7280;">
      Query {{ ks.query_id }} · {{ ks.source_label }} · Confidence {{ ks.confidence | upper }}
      {% if ks.chart_png_size_bytes %} · PNG {{ ks.chart_png_size_bytes | filesizeformat }}{% endif %}
    </td>
  </tr>
  <tr>
    <td style="padding:0 16px 16px 16px;">
      {% if ks.message %}
      <p style="margin:0 0 12px 0; font-size:14px; line-height:1.6; color:{% if ks.is_degraded %}#9A3412{% else %}#374151{% endif %};">{{ ks.message }}</p>
      {% endif %}
      {% if ks.render_mode == "metric_highlight" and ks.metrics %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 12px 0;">
        <tr>
          {% for metric in ks.metrics %}
          <td style="padding:10px 12px; border:1px solid #E5E7EB; background-color:#F9FAFB; vertical-align:top; width:33%;">
            <p style="margin:0; font-size:11px; line-height:1.4; text-transform:uppercase; color:#6B7280;">{{ metric.label }}</p>
            <p style="margin:6px 0 0 0; font-size:18px; line-height:1.3; font-weight:600; color:#111827;">{{ metric.value }}</p>
          </td>
          {% if loop.index is divisibleby 3 and not loop.last %}</tr><tr>{% endif %}
          {% endfor %}
        </tr>
      </table>
      {% elif ks.render_mode == "chart" %}
      {% if ks.is_degraded and ks.cache_captured_at %}
      <div style="margin:0 0 10px 0; padding:8px 12px; background-color:#FFFBEB; border-left:3px solid #F59E0B;">
        <p style="margin:0; font-size:12px; line-height:1.5; color:#92400E;">Chart data from gather run {{ ks.cache_captured_at | datetimeformat if ks.cache_captured_at else "unknown" }} — live data unavailable</p>
      </div>
      {% endif %}
      {% if ks.chart_png_base64 %}
      <p style="margin:0 0 4px 0;">
        {% if ks.reference_url %}<a href="{{ ks.reference_url }}" target="_blank" style="display:block; text-decoration:none;">{% endif %}
        <img src="data:image/png;base64,{{ ks.chart_png_base64 }}" alt="{{ ks.title }} chart" style="display:block; width:100%; max-width:608px; height:auto; border:1px solid #E5E7EB;" width="608" />
        {% if ks.reference_url %}</a>{% endif %}
      </p>
      {% if ks.cache_captured_at %}
      <p style="margin:0 0 10px 0; font-size:10px; line-height:1.4; color:#6B7280;">Source: {{ ks.source_label }} · query {{ ks.query_id }} · cached {{ ks.cache_captured_at | datetimeformat if ks.cache_captured_at else "" }} (live unavailable)</p>
      {% else %}
      <p style="margin:0 0 10px 0; font-size:10px; line-height:1.4; color:#6B7280;">Source: {{ ks.source_label }} · query {{ ks.query_id }}{% if ks.captured_at %} · {{ ks.captured_at | datetimeformat }}{% endif %}</p>
      {% endif %}
      {% else %}
      <p style="margin:0 0 12px 0; font-size:13px; line-height:1.5; color:#6B7280; text-align:center; padding:20px 0;">No data available for this period.{% if ks.reference_url %} <a href="{{ ks.reference_url }}" style="color:#2563EB; text-decoration:underline;">View data →</a>{% endif %}</p>
      {% endif %}
      {% elif ks.render_mode == "chart_image" and ks.image_data_url %}
      <p style="margin:0 0 12px 0;"><img src="{{ ks.image_data_url }}" alt="{{ ks.title }} chart" style="display:block; width:100%; max-width:608px; height:auto; border:1px solid #E5E7EB;" /></p>
      {% endif %}
      {% if ks.rows %}
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:collapse; margin:0 0 12px 0;">
        <tr>
          {% for column in ks.columns %}
          <td style="padding:8px 10px; background-color:#F9FAFB; border-bottom:1px solid #E5E7EB; font-size:11px; line-height:1.4; font-weight:600; text-transform:uppercase; color:#6B7280;">{{ column }}</td>
          {% endfor %}
        </tr>
        {% for row in ks.rows %}
        <tr>
          {% for cell in row %}
          <td style="padding:8px 10px; border-bottom:1px solid #E5E7EB; font-size:13px; line-height:1.5; color:#374151;">{% if cell.href %}<a href="{{ cell.href }}" style="color:#2563EB; text-decoration:underline;">{{ cell.text }}</a>{% else %}{{ cell.text }}{% endif %}</td>
          {% endfor %}
        </tr>
        {% endfor %}
      </table>
      {% endif %}
      {% if ks.reference_url %}
      <p style="margin:0 0 8px 0; font-size:13px; line-height:1.5;"><a href="{{ ks.reference_url }}" style="color:#2563EB; text-decoration:underline;">Reference dashboard →</a></p>
      {% endif %}
      {% if ks.caveats %}
      <p style="margin:0; font-size:12px; line-height:1.5; color:#6B7280;">Caveats: {{ ks.caveats | join("; ") }}</p>
      {% endif %}
    </td>
  </tr>
</table>