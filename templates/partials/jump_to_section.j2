{% if continuity.jump_links %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" data-vertex-block="jump-to-section" style="width:100%; border-collapse:collapse; margin:0 0 16px 0;">
  <tr>
    <td style="padding:0 0 8px 0; font-size:13px; line-height:1.5; font-weight:700; color:#111827; text-transform:uppercase; letter-spacing:0.04em;">Jump to section</td>
  </tr>
  <tr>
    <td style="padding:0;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; border-collapse:separate; border-spacing:0; table-layout:fixed;">
        {% for row in continuity.jump_links | batch(3, None) %}
        <tr>
          {% for link in row %}
          <td style="width:33.33%; padding:0 8px 8px 0; vertical-align:top;">
            {% if link %}
            <a href="#{{ link.anchor_id }}" style="display:block; padding:8px 10px; border:1px solid #E5E7EB; background-color:#F9FAFB; font-size:12px; line-height:1.4; font-weight:600; color:#374151; text-decoration:none;">{{ link.label }}</a>
            {% else %}
            &nbsp;
            {% endif %}
          </td>
          {% endfor %}
        </tr>
        {% endfor %}
      </table>
    </td>
  </tr>
</table>
{% endif %}