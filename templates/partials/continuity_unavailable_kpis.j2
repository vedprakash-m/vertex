{% set unavailable_sections = kusto_sections | selectattr("is_degraded") | list %}
{% if unavailable_sections %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%; margin:20px 0 24px 0; border:1px solid #D1D5DB;">
  <tr>
    <td colspan="2" style="padding:10px 12px; background-color:#F3F4F6; border-bottom:1px solid #D1D5DB; font-family:Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif; font-size:13px; font-weight:600; color:#111827;">
      KPI data unavailable
    </td>
  </tr>
  {% for section in unavailable_sections %}
  <tr>
    <td style="padding:10px 12px; width:38%; border-bottom:1px solid #E5E7EB; vertical-align:top; font-family:Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#111827;">
      {{ section.title }}
    </td>
    <td style="padding:10px 12px; border-bottom:1px solid #E5E7EB; vertical-align:top; font-family:Segoe UI, -apple-system, Roboto, Helvetica, Arial, sans-serif; font-size:13px; color:#4B5563;">
      {{ section.message or "Unavailable" }}. Source: {{ section.source_label }} ({{ section.query_id }}).
    </td>
  </tr>
  {% endfor %}
</table>
{% endif %}
